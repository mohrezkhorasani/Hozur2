@inject NavigationManager Navigation
<!-- ================================
       START DASHBOARD NAV
================================= -->
<div class="sidebar-nav-body">
    <div class="side-menu-close">
        <i class="la la-times"></i>
    </div><!-- end menu-toggler -->
    <div class="author-content">
        <div class="d-flex align-items-center">
            <div class="author-img avatar-sm">
                <img src="https://hekmateislami.com/wp-content/uploads/2018/03/cropped-arm-192x192.jpg" alt="testimonial image">
            </div>
            <div class="author-bio">
                <h4 class="author__title"> مجمع عالی حکمت اسلامی</h4>
                <span class="author__meta">پنل مدیریت بیگ بلو باتن</span>
            </div>
        </div>
    </div>
    <div class="sidebar-menu-wrap">
        <ul class="sidebar-menu toggle-menu list-items">

            <li class="@(IsActive("/") ? "page-active" : "")"><a href=""><i class="la la-dashboard mr-2 @(IsActive("/") ? "" : "text-color")"></i>دشبرد</a></li>
            <li class="@(IsActive("/teacher") ? "page-active" : "")"><a href="teacher"><i class="la la-school  mr-2 @(IsActive("/teacher") ? "" : "text-color")"></i>اساتید</a></li>
            <li class="@(IsActive("/meetings") ? "page-active" : "")">
                <a href="/meetings"><i class="la la-chalkboard-teacher mr-2 @(IsActive("/meetings") ? "text-color-white" : "text-color-3")"></i>جلسات</a>
            </li>
            <li class="@(IsActive("/partis") ? "page-active" : "")">
                <a href="partis"><i class="la la-user-friends mr-2 @(IsActive("/partis") ? "text-color-white" : "text-color-3")"></i>شرکت کنندگان</a>
            </li>
            <li class="@(IsActive("/certs") ? "page-active" : "")">
                <a href="admin-dashboard-travellers.html"><i class="lala lala-certificate mr-2 @(IsActive("/certs") ? "text-color-white" : "text-color-3")"></i>گواهینامه های صادرشده</a>
            </li>
            <li class="@(IsActive("/certs") ? "page-active" : "")">
                <a href="rooms"><i class="lala lala-certificate mr-2 @(IsActive("/rooms") ? "text-color-white" : "text-color-3")"></i>لیست گروه ها</a>
            </li>
            <li><a href="index.html"><i class="la la-power-off mr-2 text-color-11"></i>خروج</a></li>
        </ul>
    </div><!-- end sidebar-menu-wrap -->
</div>
<!-- ================================
       END DASHBOARD NAV
================================= -->
@code {
    private bool IsActive(string href)
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);

        // If href is "/" (Dashboard), check for empty path
        if (href == "/" && string.IsNullOrEmpty(relativePath))
        {
            return true;
        }

        // Normalize href (remove leading slash)
        var normalizedHref = href.TrimStart('/');
        return !string.IsNullOrEmpty(normalizedHref) && relativePath.StartsWith(normalizedHref, StringComparison.OrdinalIgnoreCase);
    }
}
@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager NavigationManager

@code{
    public bool Loading{ get; set; }
}

<div dir="rtl">
    <div class="sidebar-nav sidebar--nav">
        <NavMenu />
    </div>

    <main style="position: relative; min-height: 80vh;">
        <!-- Loading Overlay -->
        @if (IsLoading)
        {
            <div class="loading-overlay">
                <div class="spinner">
                    <div class="rect1"></div>
                    <div class="rect2"></div>
                    <div class="rect3"></div>
                    <div class="rect4"></div>
                    <div class="rect5"></div>
                </div>
                <p class="mt-3 text-white">در حال بارگذاری...</p>
            </div>
        }

        @Body
    </main>
</div>
@code {
    private bool IsLoading { get; set; } = true; // اولین بار لودینگ نشان داده شود
    private Timer? _timer;

    protected override void OnInitialized()
    {
        // هر بار که روت تغییر کرد
        NavigationManager.LocationChanged += OnLocationChanged;

        // برای اولین لود، بعد از 300ms لودینگ را مخفی کن (یا بیشتر بسته به سرعت)
        StartLoadingTimer();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        IsLoading = true;
        StateHasChanged();

        // بعد از حداکثر 8 ثانیه لودینگ را مخفی کن (جلوگیری از گیر کردن)
        StartLoadingTimer();
    }

    private void StartLoadingTimer()
    {
        _timer?.Dispose();
        _timer = new Timer(_ =>
        {
            IsLoading = false;
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromMilliseconds(300), Timeout.InfiniteTimeSpan);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        _timer?.Dispose();
    }
}

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>


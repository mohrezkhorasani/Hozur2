@page "/counter"
@rendermode InteractiveServer
<div style="margin-left:110px" dir="rtl">

<h1>Counter</h1>
<p>Current count: @currentCount</p>

<button @onclick="IncrementCount">Click me</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
</div>

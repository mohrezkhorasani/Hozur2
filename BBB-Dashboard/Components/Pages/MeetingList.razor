<section class="dashboard-area">
    <BBB_Dashboard.Components.Layout.Header />

    <div class="dashboard-content-wrap">
        <div class="dashboard-bread dashboard--bread dashboard-bread-2">
            <div class="container-fluid">
                <div class="row align-items-center">
                    <div class="col-lg-6">
                        <div class="breadcrumb-content">
                            <div class="section-heading">
                                <h2 class="sec__title font-size-30 text-white">جلسات</h2>
                            </div>
                        </div><!-- end breadcrumb-content -->
                    </div><!-- end col-lg-6 -->
                    <div class="col-lg-6">
                        <div class="breadcrumb-list text-right">
                            <ul class="list-items">
                                <li><a href="/" class="text-white">صفحه اصلی</a></li>
                                <li>دشبرد</li>
                                <li>جلسات</li>
                            </ul>
                        </div><!-- end breadcrumb-list -->
                    </div><!-- end col-lg-6 -->
                </div><!-- end row -->
            </div>
        </div><!-- end dashboard-bread -->
        <div class="dashboard-main-content">
            <div class="container-fluid">

                @if (GetLastMeetingResponse != null)
                {
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="form-box">
                                <div class="form-title-wrap">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div>
                                            <h3 class="title">لیست جلسات</h3>
                                            <p class="font-size-14">نمایش @(CountPerPage * (CurrentPage - 1)) تا @(GetLastMeetingResponse.CountAll / CountPerPage) از @GetLastMeetingResponse.CountAll نتیجه</p>
                                        </div>
                                        <div class="select-contain">
                                            <select class="select-contain-select">
                                                <option value="1">هر زمانی</option>
                                                <option value="2">جدید ترین</option>
                                                <option value="3">قدیمی ترین</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-content">
                                    <div class="table-form table-responsive">
                                        <table class="table">
                                            <thead>
                                                <tr>
                                                    <th scope="col">نام گروه</th>
                                                    <th scope="col">نام مدیر</th>
                                                    <th scope="col">عنوان جلسه</th>
                                                    <th scope="col">استاد</th>
                                                    <th scope="col">تعداد شرکت کنندگان</th>
                                                    <th scope="col">تاریخ</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var i in GetLastMeetingResponse.SharedOBJ_Rooms)
                                                {
                                                    <tr>
                                                        <th scope="row">@i.RoomTitle.Name</th>
                                                        <td>
                                                            <div class="table-content">
                                                                <h3 class="title">@i.ModeratorTitle.Name</h3>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            @(i.MeetTitle == null ? "-" : i.MeetTitle)
                                                        </td>
                                                        <td>@(i.TeacherTitle == null ? "-" : i.TeacherTitle.Name)</td>
                                                        <td>
                                                            <a href="/meetings#modal" @onclick="() => OpenModal(GetLastMeetingResponse.SharedOBJ_Rooms.IndexOf(i))"> @i.Partis.Count</a>
                                                        </td>
                                                        <td><span class="badge badge-success py-1 px-2">@Statics.GetPersianDate(@i.Date) @i.Date.ToString("HH:mm")</span></td>
                                                        @* <td>
                                                            <div class="table-content">
                                                                <a @onclick="() => OpenModal(GetLastMeetingResponse.SharedOBJ_Rooms.IndexOf(i))" class="theme-btn theme-btn-small mr-2" data-toggle="tooltip" data-placement="top" title="مشاهده جزئیات"><i class="la la-eye"></i></a>
                                                                <a href="#" class="theme-btn theme-btn-small" data-toggle="modal" data-target="#modalPopup"><i class="la la-envelope"></i></a>
                                                            </div>
                                                        </td> *@
                                                    </tr>

                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div><!-- end form-box -->
                        </div><!-- end col-lg-12 -->
                    </div>

                    <!-- end row -->
                    <div class="row">
                        <div class="col-lg-12">
                            <nav aria-label="Page navigation example">
                                <ul class="pagination">
                                    <!-- Previous -->
                                    <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                        <a class="page-link page-link-nav" href="/meetings?page=@((CurrentPage + 1).ToString())"
                                           @onclick="GoPrev" @onclick:preventDefault
                                           aria-label="Previous">
                                            <span aria-hidden="true"><i class="la la-angle-right"></i></span>
                                            <span class="sr-only">قبلی</span>
                                        </a>
                                    </li>

                                    @* Render page numbers *@
                                    @for (int p = 1; p <= TotalPages; p++)
                                    {
                                        var page = p;   // capture loop variable
                                                        <li class="page-item @(page == CurrentPage ? "active" : "")">
                                                            <a class="page-link page-link-nav" href="/meetings?page=@(page.ToString())"
                                                               @onclick="() => GoToPage(page)" @onclick:preventDefault>
                                                                @(page.ToString())
                                                @if (page == CurrentPage)
                                                {
                                                    <span class="sr-only">(جاری)</span>
                                                }
                                            </a>
                                        </li>
                                    }

                                <!-- Next -->
                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link page-link-nav" href="/meetings?page=@((CurrentPage + 1).ToString())"
                                       @onclick="GoNext" @onclick:preventDefault
                                       aria-label="Next">
                                        <span aria-hidden="true"><i class="la la-angle-left"></i></span>
                                        <span class="sr-only">بعدی</span>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
                @code {
                    private void GoPrev() => GoToPage(CurrentPage - 1);
                    private void GoNext() => GoToPage(CurrentPage + 1);
                    private int TotalPages => (int)Math.Ceiling((double)GetLastMeetingResponse.CountAll / CountPerPage);
                    private void GoToPage(int page)
                    {
                        if (page < 1 || page > TotalPages) return;
                        CurrentPage = page;
                        _ = CallGetLastMeetingResponse();
                    }
                }
                                }
                                else
                {
                    <h3 class="title">در حال بارگیری جلسات</h3>
                }
                <div class="border-top mt-5"></div>
                <div class="row align-items-center">
                    <BBB_Dashboard.Components.Layout.MyFooter />

                </div>

                <!-- end row -->
            </div>

            <!-- end container-fluid -->
        </div>

        <!-- end dashboard-main-content -->
    </div><!-- end dashboard-content-wrap -->
</section><!-- end dashboard-area -->
<!-- ================================
    END DASHBOARD AREA
================================= -->

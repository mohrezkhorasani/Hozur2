@code {
    @inject IGetLastMeetingUseCase IGetLastMeetingUseCase
    private GetLastMeetingResponse GetLastMeetingResponse;
    private int CurrentPage = 1;
    private int CountPerPage = 10;
    private async Task CallGetLastMeetingResponse()
    {
        // ساخت Request
        var request = new GetLastMeetingRequest
        {
            Page = CurrentPage,
            Count = CountPerPage,
        };

        // ساخت Presenter
        var presenter = new GenericPresenter<GenericResponse<GetLastMeetingResponse>>();
        // var GetLastMeetingResponsePer = new GenersicPresenter<GenericResponse<GetLastMeetingResponse>>();

        // صدا زدن UseCase
        await IGetLastMeetingUseCase.handleAsync(request, presenter);
        // await IGetLastMeetingUseCase.handleAsync(new GetLastMeetingRequest { }, GetLastMeetingResponsePer);



        // دریافت Response از Presenter
        GetLastMeetingResponse = presenter.Response.data;
        // GetLastMeetingResponse = GetLastMeetingResponsePer.Response.data;
        StateHasChanged();
    }


    protected async override Task OnInitializedAsync()
    {
        _ = CallGetLastMeetingResponse();
        string UserIP = HttpContextAccessor.HttpContext?.Items["UserIP"]?.ToString(); 
        string UserIP2 = HttpContextAccessor.HttpContext?.Connection?.RemoteIpAddress?.ToString();

    }
}



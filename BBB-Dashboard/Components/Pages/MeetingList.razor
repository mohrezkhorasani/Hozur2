@if (showModal)
{
    <div class="modal-backdrop fade show " @onclick="CloseModal"></div>
    <div class="modal fade show d-block" tabindex="-1" style="direction: rtl;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">شرکت‌کننده‌ها</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>

                <div class="modal-body" style="max-height: 60vh; overflow-y: auto;">
                    <ul class="list-group">
                        @foreach (var p in PagedPartis)
                        {
                            <li class="list-group-item text-end">
                                <strong>@p.ID</strong> - @p.Name
                            </li>
                        }
                    </ul>
                </div>

                <div class="modal-footer d-flex justify-content-between">
                    <div>
                        صفحه @currentPage از @totalPages
                    </div>
                    <div>
                        <button class="btn btn-outline-secondary btn-sm me-1"
                                @onclick="PrevPage" disabled="@isFirstPage">
                            قبلی
                        </button>

                        <button class="btn btn-outline-secondary btn-sm"
                                @onclick="NextPage" disabled="@isLastPage">
                            بعدی
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
}

@code {
    private int currentPage = 1;
    private int pageSize = 10;

    private bool showModal = false;
    private List<SharedOBJ_Partis> CurrentPartis = new List<SharedOBJ_Partis>();
    private IEnumerable<SharedOBJ_Partis> PagedPartis => CurrentPartis.Skip((currentPage - 1) * pageSize).Take(pageSize);
    private int totalPages => (int)Math.Ceiling((double)CurrentPartis.Count / pageSize);
    private bool isFirstPage => currentPage == 1;
    private bool isLastPage => currentPage == totalPages;

    private void OpenModal(int index)
    {
        showModal = true;
        CurrentPartis = GetLastMeetingResponse.SharedOBJ_Rooms[index].Partis;
        StateHasChanged();
    }
    private void NextPage()
    {
        if (!isLastPage)
            currentPage++;
    }

    private void PrevPage()
    {
        if (!isFirstPage)
            currentPage--;
    }
    private void CloseModal()
    {
        showModal = false;
    }
}


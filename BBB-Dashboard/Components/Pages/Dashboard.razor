@inject IGetTrophiesUseCase IGetTrophiesUseCase
@inject IGetRoomStatsUseCase IGetRoomStatsUseCase
@code {
    public bool LoadingPage = true;
    private List<string> BG = new List<string>();
    private GetTrophiesResponse GetTrophiesResponse;
    private GetRoomStatsResponse GetRoomStatsResponse;
    private async Task CallGetTrophiesResponse()
    {
        // ساخت Request
        var request = new GetTrophiesRequest
        {

        };

        // ساخت Presenter
        var presenter = new GenericPresenter<GenericResponse<GetTrophiesResponse>>();
        // var GetRoomStatsResponsePer = new GenersicPresenter<GenericResponse<GetRoomStatsResponse>>();

        // صدا زدن UseCase
        await IGetTrophiesUseCase.handleAsync(request, presenter);
        // await IGetRoomStatsUseCase.handleAsync(new GetRoomStatsRequest { }, GetRoomStatsResponsePer);



        // دریافت Response از Presenter
        GetTrophiesResponse = presenter.Response.data;
        LoadingPage = false;
        StateHasChanged();
    }
    @inject IGetLastMeetingUseCase IGetLastMeetingUseCase
    private GetLastMeetingResponse GetLastMeetingResponse;
    private async Task CallGetLastMeetingResponse()
    {
        // ساخت Request
        var request = new GetLastMeetingRequest
        {
            Count = 6,
            Page = 1
        };

        // ساخت Presenter
        var presenter = new GenericPresenter<GenericResponse<GetLastMeetingResponse>>();
        // var GetRoomStatsResponsePer = new GenersicPresenter<GenericResponse<GetRoomStatsResponse>>();

        // صدا زدن UseCase
        await IGetLastMeetingUseCase.handleAsync(request, presenter);
        // await IGetRoomStatsUseCase.handleAsync(new GetRoomStatsRequest { }, GetRoomStatsResponsePer);



        // دریافت Response از Presenter
        GetLastMeetingResponse = presenter.Response.data;
        LoadingPage = false;
        StateHasChanged();
    }
    @inject IGetLastCertUseCase IGetLastCertUseCase
    private GetLastCertResponse GetLastCertResponse;
    private async Task CallGetLastCertResponse()
    {
        // ساخت Request
        var request = new GetLastCertRequest
        {
            Count = 6,
            Page = 1
        };

        // ساخت Presenter
        var presenter = new GenericPresenter<GenericResponse<GetLastCertResponse>>();
        // var GetRoomStatsResponsePer = new GenersicPresenter<GenericResponse<GetRoomStatsResponse>>();

        // صدا زدن UseCase
        await IGetLastCertUseCase.handleAsync(request, presenter);
        // await IGetRoomStatsUseCase.handleAsync(new GetRoomStatsRequest { }, GetRoomStatsResponsePer);



        // دریافت Response از Presenter
        GetLastCertResponse = presenter.Response.data;
        LoadingPage = false;
        StateHasChanged();
    }
    private async Task CallGetRoomStatsResponse()
    {
        // ساخت Request
        var request = new GetRoomStatsRequest
        {

        };

        // ساخت Presenter
        var presenter = new GenericPresenter<GenericResponse<GetRoomStatsResponse>>();

        // صدا زدن UseCase
        await IGetRoomStatsUseCase.handleAsync(request, presenter);



        GetRoomStatsResponse = presenter.Response.data;
        VisibleRooms = GetRoomStatsResponse.Rooms.Take(8).ToList();
    }

    @inject IGetLivesUseCase IGetLivesUseCase
    private GetLivesResponse GetLivesResponse;
    private async Task CallGetLivesResponse()
    {
        // ساخت Request
        var request = new GetLivesRequest
        {

        };

        // ساخت Presenter
        var presenter = new GenericPresenter<GenericResponse<GetLivesResponse>>();
        // var GetLivesResponsePer = new GenersicPresenter<GenericResponse<GetLivesResponse>>();

        // صدا زدن UseCase
        await IGetLivesUseCase.handleAsync(request, presenter);
        // await IGetLivesUseCase.handleAsync(new GetLivesRequest { }, GetLivesResponsePer);



        // دریافت Response از Presenter
        GetLivesResponse = presenter.Response.data;
        // GetLivesResponse = GetLivesResponsePer.Response.data;
        StateHasChanged();
    }
    protected override async Task OnInitializedAsync()
    {
        LoadingPage = true;
        StateHasChanged();
        var r = HttpContextAccessor.HttpContext;
        for (int i = 0; i < 4;)
        {
            var rand = new Random().Next(1, 25);
            if (new int[] { 20, 10, 7, 15, 14, 6, 19 }.Contains(rand)) continue;
            i++;
            BG.Add(rand.ToString());
        }
        #region GetTrophiesResponse
        _ = CallGetTrophiesResponse();
        // _ = CallGetRoomStatsResponse();
        _ = CallGetLivesResponse();
        _ = CallGetLastMeetingResponse();
        _ = CallGetLastCertResponse();
        #endregion



    }
}



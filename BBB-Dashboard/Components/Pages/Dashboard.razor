                    @code {
                        private List<ChartData> ChartDataList = new();

                        protected override async Task OnAfterRenderAsync(bool firstRender)
                        {
                            if (firstRender)
                            {
                                ChartDataList = new List<ChartData>
                                        {
                                        new ChartData { Label = "فروردین", Value = 120 },
                                        new ChartData { Label = "اردیبهشت", Value = 190 },
                                        new ChartData { Label = "خرداد", Value = 150 },
                                        new ChartData { Label = "تیر", Value = 280 },
                                        new ChartData { Label = "مرداد", Value = 220 },
                                        new ChartData { Label = "شهریور", Value = 310 }
                                        };

                                await RenderChart();
                            }
                        }

                        private async Task RenderChart()
                        {
                            var labels = ChartDataList.Select(x => x.Label).ToArray();
                            var values = ChartDataList.Select(x => x.Value).ToArray();

                            var config = new
                            {
                                type = "bar",
                                data = new
                                {
                                    labels = labels,
                                    datasets = new[]
                            {
                                        new
                                        {
                                        label = "تعداد شرکت‌کنندگان",
                                        data = values,
                                        backgroundColor = "rgba(54, 162, 235, 0.7)",
                                        borderColor = "rgba(54, 162, 235, 1)",
                                        borderWidth = 1,
                                        borderRadius = 8,
                                        barThickness = 30
                                        }
                                        }
                                },
                                options = new
                                {
                                    responsive = true,
                                    maintainAspectRatio = false,
                                    plugins = new
                                    {
                                        legend = new { display = false },
                                        tooltip = new
                                        {
                                            callbacks = new
                                            {
                                                label = @"
                                        function(context) {
                                        return 'تعداد: ' + context.parsed.y + ' نفر';
                                        }"
                                            }
                                        }
                                    },
                                    scales = new
                                    {
                                        y = new
                                        {
                                            beginAtZero = true,
                                            ticks = new { stepSize = 50 }
                                        }
                                    }
                                }
                            };

                            await JS.InvokeVoidAsync("renderBarChart", "participantsBarChart", config);
                        }

                        public class ChartData
                        {
                            public string Label { get; set; } = "";
                            public int Value { get; set; }
                        }
                    }


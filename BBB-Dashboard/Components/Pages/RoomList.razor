<section class="dashboard-area">
    <BBB_Dashboard.Components.Layout.Header />

    <div class="dashboard-content-wrap">
        <div class="dashboard-bread dashboard--bread dashboard-bread-2">
            <div class="container-fluid">
                <div class="row align-items-center">
                    <div class="col-lg-6">
                        <div class="breadcrumb-content">
                            <div class="section-heading">
                                <h2 class="sec__title font-size-30 text-white">گروه ها</h2>
                            </div>
                        </div><!-- end breadcrumb-content -->
                    </div><!-- end col-lg-6 -->
                    <div class="col-lg-6">
                        <div class="breadcrumb-list text-right">
                            <ul class="list-items">
                                <li><a href="/" class="text-white">صفحه اصلی</a></li>
                                <li>دشبرد</li>
                                <li>گروه ها</li>
                            </ul>
                        </div><!-- end breadcrumb-list -->
                    </div><!-- end col-lg-6 -->
                </div><!-- end row -->
            </div>
        </div><!-- end dashboard-bread -->
        <div class="dashboard-main-content">
            <div class="container-fluid">

                @if (GetRoomsResponse != null)
                {
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="form-box">
                                <div class="form-title-wrap">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div>
                                            <h3 class="title">لیست جلسات</h3>
                                            <p class="font-size-14">نمایش @(CountPerPage * (CurrentPage - 1)) تا @(GetRoomsResponse.Data.Count / CountPerPage) از @GetRoomsResponse.Data.Count نتیجه</p>
                                        </div>
                                        <div class="select-contain">
                                            <select class="select-contain-select">
                                                <option value="1">هر زمانی</option>
                                                <option value="2">جدید ترین</option>
                                                <option value="3">قدیمی ترین</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="container mt-4">
                                    <h2 class="mb-3">لیست گروه‌ها</h2>

                                    <table class="table table-striped table-bordered table-hover">
                                        <thead class="table-dark">
                                            <tr>
                                                <th scope="col">نام گروه</th>
                                                <th scope="col">آخرین جلسه</th>
                                                <th scope="col">تعداد جلسات</th>
                                                <th scope="col">تعداد اساتید</th>
                                                <th scope="col">تعداد اعضا</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <!-- نمونه داده‌ها -->
                                            @if (GetRoomsResponse != null)
                                            {
                                                @foreach(var i in GetRoomsResponse.Data)
                                                {
                                                    <tr >
                                                        <td>@i.Title</td>
                                                        <td class="text-center">
                                                            <p>
                                                                @(PersianDateHelper.GetPersianDayName(@i.LastMeet) + "\t" + @i.LastMeet.ToString("HH:mm") + "\n")

                                                            </p>
                                                            <p>
                                                                @Statics.GetPersianDate(@i.LastMeet)
                                                            </p>

                                                        </td>
                                                        <td class="text-center">@i.Count</td>
                                                        <td class="text-center">@i.CountTeacher</td>
                                                        <td class="text-center">@i.CountPartis</td>
                                                    </tr>
                                                }
                                              
                                            }
                                       
                                        
                                        </tbody>
                                    </table>
                                </div>

                            </div><!-- end form-box -->
                        </div><!-- end col-lg-12 -->
                    </div>

                    <!-- end row -->
                    <div class="row">
                        <div class="col-lg-12">
                            <nav aria-label="Page navigation example">
                                <ul class="pagination">
                                    <!-- Previous -->
                                    <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                        <a class="page-link page-link-nav" href="/meetings?page=@((CurrentPage + 1).ToString())"
                                           @onclick="GoPrev" @onclick:preventDefault
                                           aria-label="Previous">
                                            <span aria-hidden="true"><i class="la la-angle-right"></i></span>
                                            <span class="sr-only">قبلی</span>
                                        </a>
                                    </li>

                                    @* Render page numbers *@
                                    @for (int p = 1; p <= TotalPages; p++)
                                    {
                                        var page = p;   // capture loop variable
                                                        <li class="page-item @(page == CurrentPage ? "active" : "")">
                                                            <a class="page-link page-link-nav" href="/meetings?page=@(page.ToString())"
                                                               @onclick="() => GoToPage(page)" @onclick:preventDefault>
                                                                @(page.ToString())
                                                @if (page == CurrentPage)
                                                {
                                                    <span class="sr-only">(جاری)</span>
                                                }
                                            </a>
                                        </li>
                                    }

                                <!-- Next -->
                                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                    <a class="page-link page-link-nav" href="/meetings?page=@((CurrentPage + 1).ToString())"
                                       @onclick="GoNext" @onclick:preventDefault
                                       aria-label="Next">
                                        <span aria-hidden="true"><i class="la la-angle-left"></i></span>
                                        <span class="sr-only">بعدی</span>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
                @code {
                    private void GoPrev() => GoToPage(CurrentPage - 1);
                    private void GoNext() => GoToPage(CurrentPage + 1);
                    private int TotalPages => (int)Math.Ceiling((double)GetRoomsResponse.Data.Count / CountPerPage);
                    private void GoToPage(int page)
                    {
                        if (page < 1 || page > TotalPages) return;
                        CurrentPage = page;
                        _ = CallGetRoomsResponse();
                    }
                }
                                }
                                else
                {
                    <h3 class="title">در حال بارگیری جلسات</h3>
                }
                <div class="border-top mt-5"></div>
                <div class="row align-items-center">
                    <BBB_Dashboard.Components.Layout.MyFooter />

                </div>

                <!-- end row -->
            </div>

            <!-- end container-fluid -->
        </div>

        <!-- end dashboard-main-content -->
    </div><!-- end dashboard-content-wrap -->
</section><!-- end dashboard-area -->
<!-- ================================
    END DASHBOARD AREA
================================= -->

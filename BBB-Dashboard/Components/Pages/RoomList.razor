@code {
    @inject IGetRoomsUseCase IGetRoomsUseCase
    private GetRoomsResponse GetRoomsResponse;
    private int CurrentPage = 1;
    private int CountPerPage = 20;
    private async Task CallGetRoomsResponse()
    {
        // ساخت Request
        var request = new GetRoomsRequest
        {
            Page = CurrentPage,
            Query=""
        };

        // ساخت Presenter
        var presenter = new GenericPresenter<GenericResponse<GetRoomsResponse>>();
        // var GetRoomsResponsePer = new GenersicPresenter<GenericResponse<GetRoomsResponse>>();

        // صدا زدن UseCase
        await IGetRoomsUseCase.handleAsync(request, presenter);
        // await IGetRoomsUseCase.handleAsync(new GetRoomsRequest { }, GetRoomsResponsePer);



        // دریافت Response از Presenter
        GetRoomsResponse = presenter.Response.data;
        // GetRoomsResponse = GetRoomsResponsePer.Response.data;
        StateHasChanged();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // return base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            // await JS.InvokeVoidAsync("setCookie", "Auth", "masalan token", 150);
        }
    }


    protected async override Task OnInitializedAsync()
    {
        _ = CallGetRoomsResponse();
        SetCookie();
    }
}
@code {
    void SetCookie()
    {
        var cookieOptions = new CookieOptions
        {
            Expires = DateTimeOffset.UtcNow.AddDays(7),
            HttpOnly = true,
            Secure = true
        };
    }

}


@code {
    private int currentPage = 1;
    private int pageSize = 10;

    private bool showModal = false;
    private List<SharedOBJ_Partis> CurrentPartis = new List<SharedOBJ_Partis>();
    private IEnumerable<SharedOBJ_Partis> PagedPartis => CurrentPartis.Skip((currentPage - 1) * pageSize).Take(pageSize);
    private int totalPages => (int)Math.Ceiling((double)CurrentPartis.Count / pageSize);
    private bool isFirstPage => currentPage == 1;
    private bool isLastPage => currentPage == totalPages;

    private void OpenModal(int index)
    {
        showModal = true;
        // CurrentPartis = GetRoomsResponse.SharedOBJ_Rooms[index].Partis;
        StateHasChanged();
    }
    private void NextPage()
    {
        if (!isLastPage)
            currentPage++;
    }

    private void PrevPage()
    {
        if (!isFirstPage)
            currentPage--;
    }
    private void CloseModal()
    {
        showModal = false;
    }
}


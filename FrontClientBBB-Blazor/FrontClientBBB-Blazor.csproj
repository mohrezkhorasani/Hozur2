    <EmbeddedResource Remove="NUDGET\**" />
    <EmbeddedResource Remove="wwwroot\FontAwesome.Pro.7.1.0\**" />
    <None Remove="NUDGET\**" />
    <None Remove="wwwroot\FontAwesome.Pro.7.1.0\**" />
  </ItemGroup>

  <ItemGroup>

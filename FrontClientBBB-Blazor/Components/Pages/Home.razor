@page "/"
@using Application.General
@using Application.Interface.IInfrastructure
@using Domain.Entity
@using FrontClientBBB_Blazor.MiddleWare
@using Microsoft.AspNetCore.Mvc
@using Presistence.Entities
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer
@inject DBContext db
@* @inject IHttpContextAccessor httpContextAccessor *@
@attribute [RequireT2Cookie("SECRET123")]
<PageTitle>لیست گروه ها</PageTitle>

@code {
    [Inject] public IBBBGetMeetings bbb { get; set; }
    public HashSet<long> LoadingStart { get; set; } = new HashSet<long>();
    public List<RoomTBL> Rooms { get; set; }
    private HashSet<long> CopiedRooms = new();

    protected override async Task OnInitializedAsync()
    {
        // await base.OnInitializedAsync();
        _ = LoadRooms();
    }
    private async Task LoadRooms()
    {
        Rooms = db.RoomTBLs.Where(e => e.Type == MainEntity_Types.ROOM_NORMAL).ToList();
        StateHasChanged();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("eval", "console.log('CSS loaded')");

        }
    }

    private async Task StartRoom(RoomTBL room)
    {
        if (LoadingStart.Contains(room.ID)) return; // جلوگیری از دوبار کلیک

        LoadingStart.Add(room.ID);
        StateHasChanged(); // برای نمایش تغییرات UI

        var resp = await OnPostStartMeeting(room);
            // await JSRuntime.InvokeVoidAsync("console.log", url, "_blank");

        LoadingStart.Remove(room.ID);
        StateHasChanged(); // برای بازگردانی دکمه

        // Extract URLs from the response (assuming it's a JsonResult)
        var jsonResult = resp as JsonResult;
        if (jsonResult != null)
        {
            dynamic data = jsonResult.Value;
            string url = data.url;
            string join = data.join;

            // Open two new tabs
            await JSRuntime.InvokeVoidAsync("open", url, "_blank");
            await JSRuntime.InvokeVoidAsync("open", join, "_blank");
        }
    }


    public async Task<IActionResult> OnPostStartMeeting(RoomTBL room)
    {
        // var Domain = $"{httpContextAccessor.HttpContext.Request.Scheme}:{httpContextAccessor.HttpContext.Request.Host}";
        var Domain = $"http://vc2.hekmateislami.com";

        if (string.IsNullOrEmpty(room.BBB_MeetID))
        {
            room.BBB_MeetID = "hekmateislamic";
        }
        var t = await bbb.CreateMeetingAsync(room.BBB_MeetID, room.Title, "r75-spv-fwr-g2t");
        var join = await bbb.GetJoinUrlAsync(room.BBB_MeetID, "مجمع عالی حکمت اسلامی", true, Statics.BBB_MODERATOR_PW);

        //Console.WriteLine(join);
        //link = join.Replace("&", "%26");
        return new JsonResult(new
        {
            url = $"{Domain}/rooms/{room.FriendlyID}/join",
            join = $"{join}"
        });
    }

    public bool IsLoading(long roomId) => LoadingStart.Contains(roomId); private bool IsCopied(long roomId) => CopiedRooms.Contains(roomId);
    private async Task CopyLink(RoomTBL room)
    {
        // فرض کنیم لینک اتاق اینه
        string link = $"https://mysite.com/room/{room.ID}";

        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", link);

        CopiedRooms.Add(room.ID);
        StateHasChanged();

        // بعد از 2 ثانیه تیک رو حذف کن
        await Task.Delay(2000);
        CopiedRooms.Remove(room.ID);
        StateHasChanged();
    }
}
@if (Rooms == null)
{
    <div class="container py-5">
        <div class="row g-4">
            گروهی برای نمایش وجود ندارد
        </div>
    </div>

}
else
{
    <div class="container py-5">
        <div class="row g-5">
            @* Repeat this col for each room/card *@
            @foreach (var i in Rooms)
            {
                <div class="col-lg-4 col-md-6 col-sm-12">
                    <div class="card room-card h-100 border-0 shadow-sm">
                        <div class="card-body text-center">
                            <div class="room-icon mb-4">
                                <!-- Example SVG Icon -->
                                <svg aria-hidden="true" data-icon="chalkboard-teacher" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512"
                                     fill="currentColor" class="bi bi-people" width="48" height="48">
                                    <path fill="currentColor" d="M160 320c53.02 0 96-42.98 96-96c0-53.02-42.98-96-96-96C106.1 128 64 170.1 64 224C64 277 106.1 320 160 320zM160 160c35.29 0 64 28.71 64 64S195.3 288 160 288S96 259.3 96 224S124.7 160 160 160zM192 352H128c-70.69 0-128 57.31-128 128c0 17.67 14.33 32 32 32h256c17.67 0 32-14.33 32-32C320 409.3 262.7 352 192 352zM32 480c0-52.94 43.07-96 96-96h64c52.94 0 96 43.06 96 96H32zM592 0h-384C181.5 0 160 21.53 160 48v32C160 88.84 167.2 96 176 96S192 88.84 192 80v-32C192 39.19 199.2 32 208 32h384C600.8 32 608 39.19 608 48v320c0 8.812-7.172 16-16 16H576v-48C576 309.5 554.5 288 528 288h-96C405.5 288 384 309.5 384 336V384h-32c-8.844 0-16 7.156-16 16S343.2 416 352 416h240C618.5 416 640 394.5 640 368v-320C640 21.53 618.5 0 592 0zM544 384h-128v-48c0-8.812 7.172-16 16-16h96c8.828 0 16 7.188 16 16V384z">
                                    </path>
                                </svg>
                            </div>
                            <h5 class="card-title mb-2">@i.Title</h5>
                            <p class="text-muted mb-0">آخرین جلسه: خطا</p>
                        </div>
                        <div class="card-footer bg-white d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center">
                                <button class="btn btn-outline-primary btn-sm"
                                        disabled="@IsLoading(i.ID)"
                                        @onclick="() => StartRoom(i)">
                                    @(IsLoading(i.ID) ? "در حال شروع..." : "شروع")
                                </button>

                                @if (IsLoading(i.ID))
                                {
                                    <div class="ms-2 flex-grow-1">
                                        <div class="progress" style="height: 4px;">
                                            <div class="progress-bar progress-bar-striped progress-bar-animated"
                                                 style="width: 100%"></div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="d-flex align-items-center">
                                <button class="btn btn-outline-secondary btn-sm ms-2"
                                        @onclick="() => CopyLink(i)">
                                    @if (IsCopied(i.ID))
                                    {
                                        <i class="bi bi-check-lg"></i>
                                        @("کپی شد")
                                    }
                                    else
                                    {
                                        <i class="bi bi-clipboard"></i>
                                        @("کپی لینک")
                                    }
                                </button>

                                <button class="btn btn-icon text-muted ms-2">
                                    <i class="bi bi-info-circle"></i>
                                </button>
                            </div>
                        </div>


                    </div>
                </div>

            }
            @* Copy the above col for multiple cards *@
        </div>
    </div>

}

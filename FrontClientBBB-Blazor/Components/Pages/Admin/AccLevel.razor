@page "/admin/access-form"
@using Application.General
@using Application.Interface.IInfrastructure
@using Application.Interfaces
@using Domain.Entity
@using FrontClientBBB_Blazor.MiddleWare
@using Microsoft.AspNetCore.Mvc
@using Microsoft.EntityFrameworkCore
@using Presistence.Entities
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer
@inject IDBContext db
@using System.ComponentModel.DataAnnotations
@* @inject IHttpContextAccessor httpContextAccessor *@
@attribute [RequireT2Cookie("SECRET123")]
<PageTitle>لیست گروه ها</PageTitle>

@code {
    [Inject] public IBBBGetMeetings bbb { get; set; }
    public HashSet<long> LoadingStart { get; set; } = new HashSet<long>();
    public List<RoomTBL> Rooms { get; set; }
    private HashSet<long> CopiedRooms = new();

    protected override async Task OnInitializedAsync()
    {
        // await base.OnInitializedAsync();
        _ = LoadRooms();
    }
    private async Task LoadRooms()
    {
        Roles = db.RoleTBLs.ToList();
        StateHasChanged();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("eval", "console.log('CSS loaded')");

        }
    }

    private async Task StartRoom(RoomTBL room)
    {
        if (LoadingStart.Contains(room.ID)) return; // جلوگیری از دوبار کلیک

        LoadingStart.Add(room.ID);
        StateHasChanged(); // برای نمایش تغییرات UI

        var resp = await OnPostStartMeeting(room);
        // await JSRuntime.InvokeVoidAsync("console.log", url, "_blank");

        LoadingStart.Remove(room.ID);
        StateHasChanged(); // برای بازگردانی دکمه

        // Extract URLs from the response (assuming it's a JsonResult)
        var jsonResult = resp as JsonResult;
        if (jsonResult != null)
        {
            dynamic data = jsonResult.Value;
            string url = data.url;
            string join = data.join;

            // Open two new tabs
            await JSRuntime.InvokeVoidAsync("open", url, "_blank");
            await JSRuntime.InvokeVoidAsync("open", join, "_blank");
        }
    }


    public async Task<IActionResult> OnPostStartMeeting(RoomTBL room)
    {
        // var Domain = $"{httpContextAccessor.HttpContext.Request.Scheme}:{httpContextAccessor.HttpContext.Request.Host}";
        var Domain = $"http://vc2.hekmateislami.com";

        if (string.IsNullOrEmpty(room.BBB_MeetID))
        {
            room.BBB_MeetID = "hekmateislamic";
        }
        var t = await bbb.CreateMeetingAsync(room.BBB_MeetID, room.Title, "r75-spv-fwr-g2t");
        var join = await bbb.GetJoinUrlAsync(room.BBB_MeetID, "مجمع عالی حکمت اسلامی", true, Statics.BBB_MODERATOR_PW);

        //Console.WriteLine(join);
        //link = join.Replace("&", "%26");
        return new JsonResult(new
        {
            url = $"{Domain}/rooms/{room.FriendlyID}/join",
            join = $"{join}"
        });
    }

    public bool IsLoading(long roomId) => LoadingStart.Contains(roomId); private bool IsCopied(long roomId) => CopiedRooms.Contains(roomId);
    private async Task CopyLink(RoomTBL room)
    {
        // فرض کنیم لینک اتاق اینه
        string link = $"https://mysite.com/room/{room.ID}";

        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", link);

        CopiedRooms.Add(room.ID);
        StateHasChanged();

        // بعد از 2 ثانیه تیک رو حذف کن
        await Task.Delay(2000);
        CopiedRooms.Remove(room.ID);
        StateHasChanged();
    }
}



<EditForm Model="model" OnValidSubmit="HandleValidSubmit">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            فرم تعریف سطح دسترسی
        </div>
        <div class="card-body">


            <!-- Root Access Level -->
            <div class="mb-3">
                <label class="form-label">Root Access Level</label>
                <InputText class="form-control" @bind-Value="model.RootAccessLevel" @oninput="AutoFillTitle" />
            </div>


            <!-- Title (Auto) -->
            <div class="mb-3">
                <label class="form-label">عنوان (اتوماتیک)</label>
                <InputText class="form-control" @bind-Value="model.Title" readonly />
            </div>


            <!-- Roles -->
            <div class="mb-3">
                <label class="form-label">Role ها</label>
                <div class="row">
                    @foreach (var role in Roles)
                    {
                        <div class="col-md-4 col-sm-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="@role" @onchange="(e) => ToggleRole(role.ID, e)" checked="@model.SelectedRoles.Contains(role.ID)" />
                                <label class="form-check-label">@role</label>
                            </div>
                        </div>
                    }
                </div>
            </div>


            <!-- Description -->
            <div class="mb-3">
                <label class="form-label">توضیحات (اختیاری)</label>
                <InputTextArea class="form-control" rows="3" @bind-Value="model.Description" />
            </div>


            <!-- Submit -->
            <div class="text-end">
                <button type="submit" class="btn btn-success px-4">
                    تایید
                </button>
            </div>

        </div>
    </div>
</EditForm>



@code {
    private AccessFormModel model = new();


    private List<RoleTBL> Roles = new List<RoleTBL>();


    private void AutoFillTitle(ChangeEventArgs e)
    {
        model.Title = $"Root - {model.RootAccessLevel}";
    }


    private void ToggleRole(long role, ChangeEventArgs e)
    {
        var isChecked = (bool)e.Value!;


        if (isChecked)
            model.SelectedRoles.Add(role);
        else
            model.SelectedRoles.Remove(role);
    }


    private void HandleValidSubmit()
    {
        AccessLevelTBL accessLevelTBL = new AccessLevelTBL
        {
            DateUpdate = DateTime.Now,
            Description = model.Description + "",
            Route = model.RootAccessLevel,
            Status = MainEntity_Status.Default,
            Type = MainEntity_Types.ROLE_MANAGER
        };
        // اینجا میتونی دیتا رو بفرستی دیتابیس یا API
        Console.WriteLine("Submitted");
        if (db.AccessLevelTBLs.Any(e => e.Route == model.RootAccessLevel))
        {
            accessLevelTBL = db.AccessLevelTBLs.Where(e => e.Route == model.RootAccessLevel).Include(e => e.AccessLevelTBLToRoleTBLs).First();
        }
        else
        {
            db.AccessLevelTBLs.Add(accessLevelTBL);
            db.SaveChanges();
        }
        foreach (var i in model.SelectedRoles)
        {
            if (!accessLevelTBL.AccessLevelTBLToRoleTBLs.Any(e => e.IDRoleTBL == i))
            {
                accessLevelTBL.AccessLevelTBLToRoleTBLs.Add(new AccessLevelTBLToRoleTBL
                {
                    IDRoleTBL = i,
                    Type = MainEntity_Types.Normal,
                    Status = MainEntity_Status.Default,
                });
            }

        }
        db.SaveChanges();
    }


    public class AccessFormModel
    {
        [Required]
        public string RootAccessLevel { get; set; } = string.Empty;


        public string Title { get; set; } = string.Empty;


        public List<long> SelectedRoles { get; set; } = new();


        public string? Description { get; set; }
    }
}
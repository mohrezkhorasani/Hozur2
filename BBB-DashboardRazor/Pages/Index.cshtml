@page "/"
@using Application.General
@using BBB_Dashboard.Pages
@using BBB_DashboardRazor.Pages.Component
@using BBB_DashboardRazor.Pages.Component.index
@using BBB_DashboardRazor.Pages.Partials
@model IndexModel
@{
    ViewData["Title"] = "دشبورد";
}

<link href="~/css/dashboard.css" rel="stylesheet" />
<link href="~/lib/line-awesome/css/line-awesome.min.css" rel="stylesheet" />

@if (Model.GetTrophiesResponse == null)
{
    <div class="preloader" id="preloader">
        <div class="loader">
            <svg class="spinner" viewBox="0 0 50 50">
                <circle class="path" cx="25" cy="25" r="20" fill="none" stroke-width="5"></circle>
            </svg>
        </div>
    </div>
}
else
{
    <!-- User Canvas Menu -->
    <div class="user-canvas-container" dir="rtl">
        <div class="side-menu-close"><i class="la la-times"></i></div>
        <div class="user-canvas-nav">
            <div class="section-tab section-tab-2 text-center pt-4 pb-3">
                <ul class="nav nav-tabs">
                    <li class="nav-item"><a class="nav-link active" data-toggle="tab" href="#notification">اطلاعیه ها</a></li>
                    <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#message">پیام ها</a></li>
                    <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#account">حساب کاربری</a></li>
                </ul>
            </div>
        </div>
        <div class="user-canvas-nav-content">
            <div class="tab-content">
                <div class="tab-pane fade show active" id="notification">
                    <partial name="Partials/_NotificationsPartial"
                             model='new List<_NotificationsPartialModel>()' />
                </div>
                <div class="tab-pane fade" id="message">
                    <partial name="Partials/_MessagesPartial"
                             model='new List<_MessagesPartialModel>()' />
                </div>
                <div class="tab-pane fade" id="account">
                    <partial name="Partials/_AccountPartial"
                             model="new _AccountPartialModel()" />
                </div>
            </div>
        </div>
    </div>

    <!-- Dashboard Area -->
  <section class="dashboard-area">
        <BBB_Dashboard.Components.Layout.Header />
        <div class="dashboard-content-wrap">
            <div class="dashboard-bread dashboard-bread-2">
                <div class="container-fluid">
                    <div class="row align-items-center">
                        <div class="col-lg-6">
                            <div class="breadcrumb-content">
                                <div class="section-heading">
                                    <h2 class="sec__title font-size-30 text-white">دشبرد</h2>
                                </div>
                            </div><!-- end breadcrumb-content -->
                        </div><!-- end col-lg-6 -->
                        <div class="col-lg-6">
                            <div class="breadcrumb-list text-right">
                                <ul class="list-items">
                                    <li><a href="https://vc.hekmateislami.com/" class="text-white">صفحه اصلی</a></li>
                                    <li>صفحات</li>
                                    <li>دشبرد</li>
                                </ul>
                            </div><!-- end breadcrumb-list -->
                        </div><!-- end col-lg-6 -->
                    </div><!-- end row -->
                    <div class="row mt-4">
                        <div class="col-lg-3 responsive-column-l">
                            <div class="icon-box icon-layout-2 dashboard-icon-box pb-0">
                                <div class="d-flex pb-3 justify-content-between">
                                    <div class="info-content">
                                        <p class="info__desc">کل جلسات!</p>
                                        <h4 class="info__title">@Model.GetTrophiesResponse.CountAllMeetings</h4>
                                    </div><!-- end info-content -->
                                    <div class="info-icon icon-element bg-4">
                                        <i class="la la-shopping-cart"></i>
                                    </div><!-- end info-icon-->
                                </div>
                                <div class="section-block"></div>
                                <a href="admin-dashboard-booking.html" class="d-flex align-items-center justify-content-between view-all">مشاهده همه<i class="la la-angle-left"></i></a>
                            </div>
                        </div><!-- end col-lg-3 -->
                        <div class="col-lg-3 responsive-column-l">
                            <div class="icon-box icon-layout-2 dashboard-icon-box pb-0">
                                <div class="d-flex pb-3 justify-content-between">
                                    <div class="info-content">
                                        <p class="info__desc">اساتید فعال این هفته !</p>
                                        <h4 class="info__title">@Model.GetTrophiesResponse.CountWeekActiveTeacher</h4>
                                    </div><!-- end info-content -->
                                    <div class="info-icon icon-element bg-3">
                                        <i class="la la-star"></i>
                                    </div><!-- end info-icon-->
                                </div>
                                <div class="section-block"></div>
                                <a href="admin-dashboard-reviews.html" class="d-flex align-items-center justify-content-between view-all">مشاهده همه<i class="la la-angle-left"></i></a>
                            </div>
                        </div><!-- end col-lg-3 -->
                        <div class="col-lg-3 responsive-column-l">
                            <div class="icon-box icon-layout-2 dashboard-icon-box pb-0">
                                <div class="d-flex pb-3 justify-content-between">
                                    <div class="info-content">
                                        <p class="info__desc">کل شرکت کنندگان !</p>
                                        <h4 class="info__title">@Model.GetTrophiesResponse.CountAllPartis</h4>
                                    </div><!-- end info-content -->
                                    <div class="info-icon icon-element bg-2">
                                        <i class="la la-envelope"></i>
                                    </div><!-- end info-icon-->
                                </div>
                                <div class="section-block"></div>
                                <a href="admin-dashboard-subscribers.html" class="d-flex align-items-center justify-content-between view-all">مشاهده همه<i class="la la-angle-left"></i></a>
                            </div>
                        </div><!-- end col-lg-3 -->
                        <div class="col-lg-3 responsive-column-l">
                            <div class="icon-box icon-layout-2 dashboard-icon-box pb-0">
                                <div class="d-flex pb-3 justify-content-between">
                                    <div class="info-content">
                                        <p class="info__desc">جلسات این هفته !</p>
                                        <h4 class="info__title">@Model.GetTrophiesResponse.CountWeekMeeting</h4>
                                    </div><!-- end info-content -->
                                    <div class="info-icon icon-element bg-1">
                                        <i class="la la-bookmark-o"></i>
                                    </div><!-- end info-icon-->
                                </div>
                                <div class="section-block"></div>
                                <a href="admin-dashboard-wishlist.html" class="d-flex align-items-center justify-content-between view-all">مشاهده همه<i class="la la-angle-left"></i></a>
                            </div>
                        </div><!-- end col-lg-3 -->
                    </div><!-- end row -->
                </div>
            </div><!-- end dashboard-bread -->
            <div class="dashboard-main-content">
                <div class="container-fluid">
                    <div class="row">


                        <component type="typeof(ClassCardsIndex)" 
                            render-mode="ServerPrerendered"
                                   param-GetRoomStatsResponse="@Model.GetRoomStatsResponse" 
                                   param-GetLivesResponse="@Model.GetLivesResponse"
                                   param-BG="@Model.BG" 
                                   />



                  

                    <!-- #endregion -->
                    <div class="row d-flex align-items-stretch">

                        <!-- کارت ۱: نمودار شرکت‌کنندگان -->
                        <div class="col-lg-6 responsive-column--m mb-4 mb-lg-0">
                            <div class="form-box dashboard-card h-100">
                                <div class="form-title-wrap">
                                    <h3 class="title">نمودار شرکت‌کنندگان</h3>
                                </div>
                                <div class="form-content">
                                    <canvas id="participantsBarChart" dir="ltr" style="height: 280px;"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- کارت ۲: آمار سرور -->
                        <div class="col-lg-6 responsive-column--m">
                            <div class="form-box dashboard-card h-100">
                                <div class="form-title-wrap">
                                    <h3 class="title">آمار سرور</h3>
                                </div>
                                <div class="form-content pb-0">
                                    <div class="dashboard-progressbar pb-4">
                                        <div class="progress">
                                            <div class="progress-bar progress-bar-striped" role="progressbar" style="width: 10%" aria-valuenow="10" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                        <p class="font-size-14 pt-1">فضای مصرفی دیسک: @Model.GetTrophiesResponse.SharedOBJ_ServerDetails.DiskUsage</p>

                                    </div>
                                    <div class="dashboard-progressbar pb-4">
                                        <div class="progress">
                                            <div class="progress-bar progress-bar-striped bg-success" role="progressbar" style="width: 25%" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                        <p class="font-size-14 pt-1">تعداد رکورد های دیتابیس: @Model.GetTrophiesResponse.SharedOBJ_ServerDetails.DatabaseRecords</p>
                                    </div>
                                    <div class="dashboard-progressbar pb-4">
                                        <div class="progress">
                                            <div class="progress-bar progress-bar-striped bg-info" role="progressbar" style="width: 80%" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                        <p class="font-size-17 pt-1">استفاده دیتابیس‌ها: @Model.GetTrophiesResponse.SharedOBJ_ServerDetails.DatabaseUsage</p>
                                    </div>
                                    <div class="dashboard-progressbar pb-4">
                                        <div class="progress">
                                            <div class="progress-bar progress-bar-striped bg-warning" role="progressbar" style="width: 75%" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                        <p class="font-size-14 pt-1">استفاده رم: @Model.GetTrophiesResponse.SharedOBJ_ServerDetails.MemoryUsage</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="col-lg-6 responsive-column--m">
                        <div class="form-box dashboard-card">
                            <div class="form-title-wrap">
                                <h3 class="title">@Model.GetTrophiesResponse.SharedOBJ_ViewDetails.Today نفر امروز از سایت بازدید کردن</h3>
                            </div>
                            <div class="form-content pb-0">
                                <div class="row">
                                    <div class="col-lg-4">
                                        <div class="sparkline-chart-item">
                                            <span class="font-size-15">بازدید</span>
                                            <h3 class="title font-size-16">@Model.GetTrophiesResponse.SharedOBJ_ViewDetails.All</h3>
                                            <div class="visits-chart mt-2"></div>
                                        </div>
                                    </div><!-- end col-lg-4 -->
                                    <div class="col-lg-4">
                                        <div class="sparkline-chart-item">
                                            <span class="font-size-15">بازدید کنندگان یونیک</span>
                                            <h3 class="title font-size-16">@Model.GetTrophiesResponse.SharedOBJ_ViewDetails.Unique</h3>
                                            <div class="visits-chart mt-2"></div>
                                        </div>
                                    </div><!-- end col-lg-4 -->
                                    <div class="col-lg-4">
                                        <div class="sparkline-chart-item">
                                            <span class="font-size-15">ورود به کلاس</span>
                                            <h3 class="title font-size-16">@Model.GetTrophiesResponse.SharedOBJ_ViewDetails.Joint</h3>
                                            <div class="previews-chart mt-2"></div>
                                        </div>
                                    </div><!-- end col-lg-4 -->

                                    <div class="col-lg-4">
                                        <div class="sparkline-chart-item">
                                            <span class="font-size-15">میانگین مدت بازدید</span>
                                            <h3 class="title font-size-16">@Model.GetTrophiesResponse.SharedOBJ_ViewDetails.AverageTimeSpent</h3>
                                            <div class="previews-chart mt-2"></div>
                                        </div>
                                    </div><!-- end col-lg-4 -->
                                </div><!-- end row -->
                            </div>
                        </div><!-- end form-box -->
                    </div>

                    <!-- end col-lg-6 -->
                    <div class="col-lg-3 responsive-column--m">
                        <div class="form-box dashboard-card">
                            <div class="form-title-wrap">
                                <h3 class="title">بازدید از طریق مرورگر</h3>
                            </div>
                            <div class="form-content py-0">
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                        كروم
                                        <span class="badge bg-info text-white badge-pill">@Model.GetTrophiesResponse.SharedOBJ_ViewDetails.Chrome</span>
                                    </li>
                                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                        فایرفاکس
                                        <span class="badge bg-info text-white badge-pill">@Model.GetTrophiesResponse.SharedOBJ_ViewDetails.FireFox</span>
                                    </li>
                                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                        سافاری
                                        <span class="badge bg-info text-white badge-pill">@Model.GetTrophiesResponse.SharedOBJ_ViewDetails.Safari</span>
                                    </li>
                                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                        اینترنت اکسپلورر
                                        <span class="badge bg-info text-white badge-pill">@Model.GetTrophiesResponse.SharedOBJ_ViewDetails.IE</span>
                                    </li>
                                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                        اوپرا
                                        <span class="badge bg-info text-white badge-pill">@Model.GetTrophiesResponse.SharedOBJ_ViewDetails.Opera</span>
                                    </li>
                                </ul>
                            </div>
                        </div><!-- end form-box -->
                    </div>

                    <!-- end col-lg-3 -->
                    <div class="col-lg-3 responsive-column--m">
                        <div class="form-box dashboard-card">
                            <div class="form-title-wrap">
                                <h3 class="title">نمای کلی موبایل</h3>
                            </div>
                            <div class="form-content py-0">
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                        دسکتاپ
                                        <span class="badge bg-info text-white badge-pill">@Model.GetTrophiesResponse.SharedOBJ_ViewDetails.Desktop</span>
                                    </li>
                                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                        تلفن همراه
                                        <span class="badge bg-info text-white badge-pill">@Model.GetTrophiesResponse.SharedOBJ_ViewDetails.Mobile</span>
                                    </li>
                                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                        تبلت
                                        <span class="badge bg-info text-white badge-pill">@Model.GetTrophiesResponse.SharedOBJ_ViewDetails.Tablet</span>
                                    </li>
                                </ul>
                            </div>
                        </div><!-- end form-box -->
                    </div>

                    <!-- end col-lg-3 -->
                </div>

                <!-- end row -->
                <div class="border-top mt-4"></div>
                <div class="row align-items-center">
                    <BBB_Dashboard.Components.Layout.MyFooter />
                </div>

                <!-- end row -->
            </div>

            <!-- end container-fluid -->
        </div>

        <!-- end dashboard-main-content -->
    </div>

    <!-- end dashboard-content-wrap -->
</section>
    <!-- Chart.js + رسم نمودار -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const ctx = document.getElementById('participantsBarChart').getContext('2d');
            new Chart(ctx, @Html.Raw(Model.ChartConfigJson));
        });
    </script>
}
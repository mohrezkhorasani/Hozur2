@* Components/RoomList.razor *@


@using Application.DTO
@using Application.General
@using Microsoft.AspNetCore.Components.Web

@* @rendermode RenderMode.InteractiveServer *@


@code {
    [Parameter] public GetRoomStatsResponse? GetRoomStatsResponse { get; set; }
    [Parameter] public GetLivesResponse? GetLivesResponse { get; set; }
    [Parameter] public List<string> BG { get; set; } = new() { "1", "2", "3", "4" };

    private List<SharedOBJ_RoomStats> VisibleRooms = new();
    private string MoreRoomTitleButton = "نمایش بیشتر";

    protected override void OnParametersSet()
    {
        // وقتی داده‌ها اومد، اول ۸ تا نشون بده
        if (GetRoomStatsResponse?.Rooms != null && VisibleRooms.Count == 0)
        {
            VisibleRooms = GetRoomStatsResponse.Rooms.Take(8).ToList();
        }
    }

    private void LoadMore()
    {
        if (VisibleRooms.Count >= GetRoomStatsResponse!.Rooms.Count)
        {
            VisibleRooms = GetRoomStatsResponse.Rooms.Take(8).ToList();
            MoreRoomTitleButton = "نمایش بیشتر";
        }
        else if (VisibleRooms.Count + 8 >= GetRoomStatsResponse.Rooms.Count)
        {
            VisibleRooms = GetRoomStatsResponse.Rooms.ToList();
            MoreRoomTitleButton = "نمایش کمتر";
        }
        else
        {
            VisibleRooms = GetRoomStatsResponse.Rooms.Take(VisibleRooms.Count + 8).ToList();
            MoreRoomTitleButton = "نمایش بیشتر";
        }
    }
}

<div class="col-lg-12">
    <div class="form-box dashboard-card">
        <div class="form-title-wrap">
            <h3 class="title">فعالیت این ماه</h3>
        </div>
        <div class="form-content">
            @if (VisibleRooms != null)
            {
                <div class="row" id="rooms-container">

                    @foreach (var i in VisibleRooms)
                    {
                        <div class="col-lg-3 responsive-column-l room-item">
                            <div class="icon-box icon-layout-2 dashboard-icon-box dashboard--icon-box bg-@BG[GetRoomStatsResponse.Rooms.IndexOf(i) % 4] pb-0">
                                <div class="d-flex pb-3 justify-content-between">
                                    <div class="info-content">
                                        <h1 class="info__title">@i.Title</h1>
                                        <h4 class="info__desc mt-4" style="color:darkgray">آخرین جلسه: @Statics.GetPersianDate(DateTime.Parse(i.LatestMeeting))</h4>
                                    </div>
                                    <div class="info-icon icon-element bg-white text-color-2">
                                        <div class="rank-circle bg-3 ">@(GetRoomStatsResponse.Rooms.IndexOf(i) + 1)</div>
                                    </div>
                                </div>

                                <div class="dashboard-stats">
                                    <div class="stat-item" data-tooltip="تعداد جلسات">
                                        <i class="la la-calendar"></i>
                                        <span>@i.CountAllMeeting</span>
                                    </div>
                                    <div class="stat-item" data-tooltip="تعداد شرکت‌کنندگان">
                                        <i class="la la-users"></i>
                                        <span>@i.CountAllPartis</span>
                                    </div>
                                    <div class="stat-item" data-tooltip="گواهینامه‌های صادرشده">
                                        <i class="la la-certificate"></i>
                                        <span>@i.CountAllCertsGenerated</span>
                                    </div>
                                    <div class="stat-item" data-tooltip="واجدین شرایط گواهینامه">
                                        <i class="la la-check-circle"></i>
                                        <span>@i.CountAllCertsReady</span>
                                    </div>
                                    <div class="stat-item" data-tooltip="تعداد اساتید">
                                        <i class="la la-chalkboard-teacher"></i>
                                        <span>@i.CountAllTeacher</span>
                                    </div>
                                    @if (GetLivesResponse != null && GetLivesResponse.Data.Any(e => e.RoomID == i.ID))
                                    {
                                        <div class="stat-item live-indicator" data-tooltip="درحال اجرا">
                                            <i class="la la-video"></i>
                                        </div>
                                    }

                                </div>

                                <div class="section-block"></div>
                                <a href="@i.Link" class="d-flex align-items-center justify-content-between view-all">
                                    برو به لینک جلسه <i class="la la-arrow-left"></i>
                                </a>
                                <a href="#" class="d-flex align-items-center justify-content-between view-all">
                                    ایجاد جلسه آزاد <i class="la la-arrow-left"></i>
                                </a>
                            </div>
                        </div>
                    }

                </div>
                @if (GetRoomStatsResponse.Rooms.Count > 8)
                {
                    <div class="text-center mt-4">
                        <button @onclick="LoadMore" class="btn btn-primary btn-sm" id="load-more-btn">
                            @MoreRoomTitleButton <i class="la la-chevron-@(VisibleRooms.Count + 8 >= GetRoomStatsResponse.Rooms.Count ? "up" : "down") ms-1"></i>

                        </button>
                    </div>
                }
            }
            else
            {
                <div>در حال بارگیری دیتا...</div>
            }
  
        </div>
    </div>

    <!-- end form-box -->
</div>
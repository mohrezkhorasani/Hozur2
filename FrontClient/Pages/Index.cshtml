@page
@using Application.DTO
@model IndexModel

@{
    ViewData["Title"] = "Home page";
}

<style>
    .form-group {
        margin-bottom: 10px;
    }

    input[type="text"], select {
        width: 550px; /* Adjust as needed */
        padding: 8px;
        font-size: 16px;
        border: 1px solid #ccc;
        border-radius: 4px;
        background-color: #fff;
    }

    .form-group label {
        margin-top: 5px;
    }

    .centered-form {
        display: flex;
        justify-content: center;
        align-items: end; /* Adjust based on your content */
        height: calc(100vh - 90vh); /* Adjust based on your content */
    }
</style>

@page "/login"
@model FrontClient.Pages.LoginPageModel

@{
    ViewData["Title"] = "ورود";
}

<style>
    body {
        font-family: 'IranianSans', sans-serif;
        background-color: #ffffff;
        margin: 0;
        padding: 20px;
    }
    h1{
        white-space: nowrap;
        display:inline-block;
    }
    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 60vh; /* Fixed height */
        border-radius: 8px;
        box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.1);
    }

    .login-form {
        background-color: #fff;
        padding: 20px;
        width: 300px; /* Fixed width */
        max-width: calc(300px + 48px); /* Add padding to the fixed width */
    }
    .centered-image {
        width: 100px;
        height: auto;
        margin-bottom: 20px;
    }
</style>

<div class="container" >
    <div class="row">
        <div class="col-md-6 offset-md-3 login-container" dir="rtl">
            <form class="login-form" method="post" asp-page-handler="LoginHandler">
                <!-- Top logo -->
                <img 
                    src="https://vc.hekmateislami.com/rails/active_storage/blobs/redirect/eyJfcmFpbHMiOnsiZGF0YSI6ImZkOTM1M2I0LWIyYzItNDEzNi1iNjRiLWI5ZjZmOTExODc2YyIsInB1ciI6ImJsb2JfaWQifX0=--094a969a855844a41788c0f8796882e278cecaa2/arm.png"
                     alt="Logo" style="width: 100px; height: auto; margin-bottom: 20px;" class="centered-image">

                <h1>مجمع عالی حکمت اسلامی</h1>
                    
                <p>لطفاً وارد شوید</p>

                    <div class="form-group">
                        <label for="username">ایمیل</label>
                    <input type="text" name="username" id="username" class="form-control" placeholder="ایمیل" asp-area="username" required>
                    </div>

                    <div class="form-group">
                        <label for="password">رمز عبور</label>
                    <input type="password" name="password" id="password" class="form-control" placeholder="رمز عبور" asp-area="password" required>
                    </div>

                    <button class="btn btn-primary" type="submit">ورود</button>
            </form>
        </div>
    </div>
</div>
